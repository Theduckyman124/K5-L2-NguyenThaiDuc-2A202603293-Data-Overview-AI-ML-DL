prefix=/home/ntduc/AI_in_aciton/lab1/.conda
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: expat
Version: 2.10.0
Description: expat XML parser
URL: https://libexpat.github.io/
Libs: -L${libdir} -lexpat
Libs.private: -lm
Cflags: -I${includedir}
Cflags.private: -DXML_STATIC
